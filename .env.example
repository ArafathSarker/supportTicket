# Copy to .env and fill in

# Django
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173

# Postgres (compose service db)
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=support

# Redis (compose service redis)
# REDIS_URL=redis://redis:6379/0

# Supabase storage (S3-compatible). Leave empty to store files locally.
# Dashboard -> Settings -> Storage -> S3 compatible keys
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=auto
SUPABASE_STORAGE_BUCKET=tickets

# Seed passwords used by `manage.py seed_demo`
SUPERADMIN_PASSWORD=SuperAdmin#123
COMPANYADMIN_PASSWORD=CompanyAdmin#123
