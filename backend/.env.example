# Copy this file to .env and set values for your PostgreSQL instance.

DJANGO_DEBUG=1
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_ALLOWED_HOSTS=*
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://support:support@localhost:5432/support

# Docker Compose overrides DATABASE_URL to use its PostgreSQL service.
POSTGRES_DB=support
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Optional S3-compatible attachment storage.
SUPABASE_S3_ENDPOINT_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=auto
SUPABASE_STORAGE_BUCKET=tickets
